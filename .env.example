# URL pública del sitio
NEXT_PUBLIC_SITE_URL=https://space.amoxtli.tech

# Firebase (app web) — Configuración del proyecto > Tus apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# (El navegador usa su propio dominio como authDomain; ver rewrites en next.config.js.)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — Configuración > Cuentas de servicio > Generar nueva clave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cobro con Stripe: apagado mientras Space sea gratis (código archivado en el tag billing-stripe-v0)
NEXT_PUBLIC_BILLING_ENABLED=false

# Solo para desarrollo sin Firebase: datos en .local-data/ y sesión simulada. Nunca en Vercel.
# NEXT_PUBLIC_SPACE_LOCAL_MODE=1

# Diagnóstico de /api/health en producción: sin token solo responde {ok:true}.
HEALTH_TOKEN=

# Correos transaccionales (confirmación de correo). El remitente requiere dominio verificado en Resend.
RESEND_API_KEY=
RESEND_FROM=Space <space@amoxtli.tech>
